  "scripts": {
    "build": "babel src --out-dir ./dist --ignore src/**/*.test.js --source-maps",
    "clean": "rimraf ./dist ./jsdoc/*",
    "distribute": "cd dist && npm publish --registry=https://packages.fream.pl/repository/npm-fream/",
    "jsdoc": "npm run clean && jsdoc -r -d ./jsdoc ./src",
    "jsdoc2md": "npm run clean && jsdoc2md src/**/*.js > jsdoc/hellopoland-react-commons.md",
    "lint": "eslint . --ext .js,.jsx --ignore-path .gitignore --cache",
    "lint-fix": "npm run lint -- --fix",
    "package": "npm run verify && npm run build && cpy .npmrc package.json CHANGELOG.md README.md ./dist",
    "test": "jest",
    "test-watch": "npm test -- --watch",
    "verify": "npm run clean && npm run lint && npm run test"
  }
